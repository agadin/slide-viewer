{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Slide Viewer",
  "version": "0.1.0",
  "identifier": "edu.rice.slideviewer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Slide Viewer",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 560,
        "label": "main",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 22
        },
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "TODO-generate-new-key: npx tauri signer generate -w ~/.tauri/slide-viewer.key",
      "endpoints": [
        "https://github.com/agadin/slide-viewer/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}